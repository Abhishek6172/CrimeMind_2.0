# Gemini API Key (optional, offline fallback used if unset)
GEMINI_API_KEY=your_gemini_api_key_here
CM_GEMINI_MODEL=gemini-3.6-flash
CM_AI_PROVIDER=gemini

# JWT Secret for session authentication
CM_JWT_SECRET=your_random_jwt_secret_here

# PostgreSQL Database Configuration
CM_DATABASE_URL=postgresql://cm_app:cm_app_dev@localhost:5432/crimemind_phase38
CM_ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crimemind_phase38
